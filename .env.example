# Agent Factory 环境配置
# 复制此文件为 .env 并填入你的 API Key 后启动
#
#   cp .env.example .env
#   vim .env          # 填入 Key
#   ./run.sh start    # 一键启动
#
# 支持所有 OpenAI 兼容接口：DeepSeek / 通义千问 / 智谱GLM / 小米MiMo / Claude 中转 / 本地 vLLM 等

# API Key（必填）
DEEPSEEK_API_KEY=sk-your-api-key-here

# API 地址（必填，改成你使用的模型平台地址）
# 常见模型平台地址：
#   DeepSeek:  https://api.deepseek.com/v1
#   通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱GLM:   https://open.bigmodel.cn/api/paas/v4
#   小米MiMo:  https://token-plan-cn.xiaomimimo.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型名称（必填，改成你使用的模型名称）
# 常见模型名称：
#   DeepSeek:  deepseek-chat
#   通义千问:   qwen-plus / qwen-turbo
#   智谱GLM:   glm-4-flash / glm-4
#   小米MiMo:  mimo-v2.5-pro
DEEPSEEK_MODEL_NAME=deepseek-chat
