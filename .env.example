# Agent Factory 环境配置
# 复制此文件为 .env 并填入你的 API Key 后启动
#
#   cp .env.example .env
#   vim .env          # 填入 Key
#   ./run.sh start    # 一键启动

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-api-key-here

# DeepSeek API 地址（通常无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型名称（通常无需修改）
DEEPSEEK_MODEL_NAME=deepseek-chat
