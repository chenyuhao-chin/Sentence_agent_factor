# Agent Factory 环境配置
# 复制此文件为 .env 并填入你的 API Key 后启动
#
#   cp .env.example .env
#   vim .env          # 填入 Key
#   ./run.sh start    # 一键启动

# API Key（必填）
DEEPSEEK_API_KEY=sk-your-api-key-here

# API 地址（支持 DeepSeek、小米 MiMo 等 OpenAI 兼容接口）
DEEPSEEK_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 模型名称
DEEPSEEK_MODEL_NAME=mimo-v2.5-pro
